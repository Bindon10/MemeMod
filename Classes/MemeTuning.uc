// Generated by tools/gen_tuning.py; edit the list there, not this file.
class MemeTuning extends ReplicationInfo;

// Live tunables. The server applies MemeTuningConfig's ini overrides and replicates the result, so clients
// predict with the server's values. Admins change them with MemeTune; Version tells consumers to re-copy.

