// Server spawns the single instance on first use; clients wait for it to replicate.
static function MemeTuning Get(WorldInfo WI)
{
	local MemeTuning MT;

	if (WI == none)
		return none;
	foreach WI.DynamicActors(class'MemeTuning', MT)
		return MT;
	if (WI.NetMode != NM_Client)
	{
		MT = WI.Spawn(class'MemeTuning');
		if (MT != none)
			MT.LoadConfigValues();
	}
	return MT;
}

// Applies "Tune=<name> <value>" lines from MemeMod.ini on top of the defaults below.
function LoadConfigValues()
{
	local string L;
	local int i, Sp;

	for (i = 0; i < class'MemeTuningConfig'.default.Tune.Length; i++)
	{
		L = class'MemeTuningConfig'.default.Tune[i];
		Sp = InStr(L, " ");
		if (Sp > 0)
			SetByName(Left(L, Sp), Mid(L, Sp + 1));
	}
	Version = 1;
	bForceNetUpdate = true;
}

function bool SetByName(string N, string S)
{
	local float V;

	V = float(S);
	if (V == 0.f && !(S ~= "0" || S ~= "0.0" || S ~= "false" || S ~= "true"))
		return false;
	if (N ~= "MCommitFraction") { MCommitFraction = V; Version++; return true; }
	if (N ~= "MServerCommitSlack") { MServerCommitSlack = V; Version++; return true; }
	if (N ~= "MChainWindupScale") { MChainWindupScale = V; Version++; return true; }
	if (N ~= "MRiposteWindupScale") { MRiposteWindupScale = V; Version++; return true; }
