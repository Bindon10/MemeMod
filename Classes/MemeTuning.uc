	if (N ~= "MHoldMax") { MHoldMax = V; Version++; return true; }
	if (N ~= "MHoldCost") { MHoldCost = V; Version++; return true; }
	if (N ~= "bMHoldOnAttackButton") { bMHoldOnAttackButton = (V != 0.f || S ~= "true"); Version++; return true; }
	if (N ~= "MemeBladeRadius") { MemeBladeRadius = V; Version++; return true; }
	if (N ~= "MemeClashRadius") { MemeClashRadius = V; Version++; return true; }
	if (N ~= "MemeProxyDelay") { MemeProxyDelay = V; Version++; return true; }
