	if (N ~= "MemeInitiativeWindow") { MemeInitiativeWindow = V; Version++; return true; }
	if (N ~= "MemeWorldMinProgress") { MemeWorldMinProgress = V; Version++; return true; }
	if (N ~= "MemeKickActiveAt") { MemeKickActiveAt = V; Version++; return true; }
	if (N ~= "MemeParryCone") { MemeParryCone = V; Version++; return true; }
	if (N ~= "MemeGuardCone") { MemeGuardCone = V; Version++; return true; }
	if (N ~= "MemeShieldCone") { MemeShieldCone = V; Version++; return true; }
	if (N ~= "MemeGuardCostLight") { MemeGuardCostLight = V; Version++; return true; }
	if (N ~= "MemeGuardCostMedium") { MemeGuardCostMedium = V; Version++; return true; }
	if (N ~= "MemeGuardCostHeavy") { MemeGuardCostHeavy = V; Version++; return true; }
	if (N ~= "MemeShieldGuardScale") { MemeShieldGuardScale = V; Version++; return true; }
